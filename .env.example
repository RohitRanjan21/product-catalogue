# Copy to .env and adjust. Every variable is optional: the defaults below run the API locally
# against Fake Store and an SMTP catcher (Mailpit) on localhost:1025. Empty values count as unset.
# Never commit .env.

# --- API server ---
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set to true only when the API sits behind our own reverse proxy (nginx in Docker), so the
# enquiry rate limit sees the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# --- Product source (Fake Store) ---
FAKESTORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=5000
CATALOGUE_CACHE_TTL_SECONDS=300
# Exactly 5 owner-chosen product ids for the home page, in display order (DECISIONS.md A1).
FEATURED_PRODUCT_IDS=3,5,11,12,18

# --- Enquiries ---
SALES_INBOX_EMAIL=sales@example.com
ENQUIRY_FROM_EMAIL=catalogue@example.com
ENQUIRY_RATE_LIMIT_PER_MINUTE=5

# --- Email (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Set both or neither. Mailpit needs neither.
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000
